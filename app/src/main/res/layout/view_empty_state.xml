<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="@dimen/empty_icon_size"
        android:layout_height="@dimen/empty_icon_size"
        android:alpha="0.5"
        android:contentDescription="@string/cd_thumbnail"
        android:src="@drawable/ic_photo"
        app:tint="@color/text_tertiary" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Body"
        tools:text="No private photos yet." />

    <!-- Shown on screens that can import (folders, images, videos): a fresh folder is empty,
         so the way to fill it has to be right there and not only in the corner FAB. -->
    <TextView
        android:id="@+id/emptyAction"
        style="@style/TextAppearance.App.SemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="@dimen/button_height"
        android:paddingHorizontal="22dp"
        android:text="@string/vault_add_media"
        android:textColor="@color/text_on_accent"
        android:textSize="15sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
