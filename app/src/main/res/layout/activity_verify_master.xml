<?xml version="1.0" encoding="utf-8"?>
<!-- Master-credential gate (Change PIN / Change pattern). Same look as the passcode and
     pattern screens: splash background, lock badge, centred copy, dark keypad / grid. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg">

    <ImageView
        android:id="@+id/lockBadge"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_app_logo"
        android:src="@drawable/ic_lock_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titlePin"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:text="@string/verify_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lockBadge" />

    <TextView
        android:id="@+id/subtitlePin"
        style="@style/TextAppearance.App.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:text="@string/verify_subtitle_pin"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titlePin" />

    <TextView
        android:id="@+id/errorPin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:textColor="@color/accent_red"
        android:textSize="@dimen/text_caption"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitlePin"
        tools:text="Incorrect. Try again." />

    <!-- ===== PIN entry ===== -->
    <LinearLayout
        android:id="@+id/pinGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorPin">

        <!-- Preview placeholders; the real dots are rebuilt by BasePinActivity. -->
        <LinearLayout
            android:id="@+id/pinDotsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/pin_dot_size"
                android:layout_height="@dimen/pin_dot_size"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:layout_width="@dimen/pin_dot_size"
                android:layout_height="@dimen/pin_dot_size"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:layout_width="@dimen/pin_dot_size"
                android:layout_height="@dimen/pin_dot_size"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_pin_dot_empty" />

            <ImageView
                android:layout_width="@dimen/pin_dot_size"
                android:layout_height="@dimen/pin_dot_size"
                android:layout_marginHorizontal="6dp"
                android:contentDescription="@null"
                android:src="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:orientation="vertical">

            <include layout="@layout/view_pin_keypad" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Pattern entry (shown instead of the keypad for pattern users) ===== -->
    <app.lock.photo.valut.core.ui.PatternLockView
        android:id="@+id/patternView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:contentDescription="@string/cd_pattern"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorPin"
        app:patternIdleNodeColor="@color/pattern_node_idle"
        app:patternIdleRingColor="@color/pattern_ring_idle"
        app:patternNodeColor="@color/pin_accent"
        app:patternPanelColor="@android:color/transparent" />

</androidx.constraintlayout.widget.ConstraintLayout>
