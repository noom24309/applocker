<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery key hand-off, styled like the rest of the setup flow: splash background,
     lock badge, native ad above the action. The copy block scrolls on short screens. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/flAdNative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/space_m">

            <ImageView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:contentDescription="@string/cd_app_logo"
                android:src="@drawable/ic_lock_badge" />

            <TextView
                style="@style/TextAppearance.App.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center"
                android:text="@string/recovery_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                style="@style/TextAppearance.App.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/recovery_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                app:cardBackgroundColor="@color/keypad_key_bg"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="0dp"
                app:strokeColor="@color/white1"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvRecoveryKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:padding="@dimen/space_l"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold"
                    tools:text="ABCD-EFGH-JKMN-PQRS" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.App.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/recovery_copy"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/primary" />

            <TextView
                style="@style/TextAppearance.App.Medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/recovery_warning"
                android:textColor="@color/accent_red"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Native Ad -->
    <FrameLayout
        android:id="@+id/flAdNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnContinue"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/extra_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:minHeight="@dimen/button_height"
        android:paddingVertical="12dp"
        android:text="@string/recovery_saved_confirm"
        android:textAllCaps="false"
        android:textColor="@color/text_on_accent"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
