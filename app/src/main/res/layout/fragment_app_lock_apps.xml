<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg"
    android:orientation="vertical">

    <!-- ===== Header: title + protected count, with a quick "Lock now" ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_card_icon"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:tint="@color/home_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.App.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Lock"
                android:textColor="@color/home_title"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvProtectedCount"
                style="@style/TextAppearance.App.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/home_subtitle"
                android:textSize="13sp"
                tools:text="6 of 9 apps protected" />
        </LinearLayout>

    </LinearLayout>

    <!-- ===== Search box (home style) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_back"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/home_hint" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/applock_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            style="@style/TextAppearance.App.Medium"
            android:textColor="@color/home_title"
            android:textColorHint="@color/home_hint"
            android:textSize="15sp" />
    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSuggestions"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:visibility="gone"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:text="@string/applock_suggestions_button"
        app:icon="@drawable/ic_shield" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/_8sdp"
            android:background="@drawable/bg_perm_surface"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_l"
            tools:listitem="@layout/item_installed_app" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/applock_no_apps"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
