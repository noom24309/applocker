<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg">

    <!-- ===== Standard / themed unlock panel =====
         Same look as activity_pattern_unlock: lock badge, centered title/subtitle,
         borderless dark grid, accent text link. applyTheme() re-colours the root and
         the title/subtitle for the DARK / GLASS / MINIMAL themes. -->
    <LinearLayout
        android:id="@+id/standardPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/flAdNative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Locked app's icon drops in here once loaded; the badge is the placeholder. -->
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/applock_overlay_title"
            android:src="@drawable/ic_lock_badge" />

        <TextView
            android:id="@+id/titlePin"
            style="@style/TextAppearance.App.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center"
            android:text="@string/applock_overlay_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/subtitlePin"
            style="@style/TextAppearance.App.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="Instagram" />

        <LinearLayout
            android:id="@+id/pinDotsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/errorPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textColor="@color/accent_red"
            android:textSize="@dimen/text_caption"
            android:visibility="invisible"
            tools:text="Wrong pattern" />

        <TextView
            android:id="@+id/tvLockoutTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:textColor="@color/accent_amber"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Try again in 00:30" />

        <app.lock.photo.valut.core.ui.PatternLockView
            android:id="@+id/patternView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:contentDescription="@string/cd_pattern"
            android:visibility="gone"
            app:patternIdleNodeColor="@color/pattern_node_idle"
            app:patternIdleRingColor="@color/pattern_ring_idle"
            app:patternNodeColor="@color/pin_accent"
            app:patternPanelColor="@android:color/transparent" />

        <!-- Pattern mode only; PIN mode puts the fingerprint key inside the keypad. -->
        <TextView
            android:id="@+id/btnUseBiometric"
            style="@style/TextAppearance.App.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="@dimen/space_xs"
            android:text="@string/biometric_use"
            android:textColor="@color/pin_accent"
            android:textSize="16sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_fingerprint"
            app:drawableTint="@color/pin_accent"
            tools:visibility="visible" />

        <Space
            android:id="@+id/pinSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/keypadContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/screen_padding"
            android:orientation="vertical">

            <include layout="@layout/view_pin_keypad" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Fake crash panel ===== -->
    <LinearLayout
        android:id="@+id/crashPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fake_crash_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:id="@+id/crashTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fake_crash_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/crashMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/fake_crash_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crashReport"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fake_crash_report" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crashOpenAgain"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fake_crash_open_again" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crashClose"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fake_crash_close" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- ===== Fake loading panel ===== -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/loadingIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/fake_loading_text"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary" />

        <ProgressBar
            android:id="@+id/loadingSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/fake_loading_text"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- ===== Fake calculator panel ===== -->
    <include
        android:id="@+id/calculatorPanel"
        layout="@layout/view_calculator_lock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Native Ad -->
    <FrameLayout
        android:id="@+id/flAdNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
