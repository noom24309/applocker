<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery-key entry, styled like the passcode screens: splash background, lock
     badge, native ad in the middle, action pinned to the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg">

    <ImageView
        android:id="@+id/lockBadge"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_app_logo"
        android:src="@drawable/ic_lock_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleForgot"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:text="@string/forgot_pin_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lockBadge" />

    <TextView
        android:id="@+id/subtitleForgot"
        style="@style/TextAppearance.App.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_28sdp"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/forgot_pin_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleForgot" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/recoveryInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/_16sdp"
        android:hint="@string/forgot_pin_hint"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="@dimen/radius_s"
        app:boxCornerRadiusBottomStart="@dimen/radius_s"
        app:boxCornerRadiusTopEnd="@dimen/radius_s"
        app:boxCornerRadiusTopStart="@dimen/radius_s"
        app:boxStrokeColor="@color/recovery_box_stroke"
        app:errorTextColor="@color/accent_red"
        app:hintTextColor="@color/pin_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleForgot">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/recoveryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Native ad, centred in the space between the field and the button -->
    <FrameLayout
        android:id="@+id/flAdNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btnVerifyKey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recoveryInputLayout" />

    <TextView
        android:id="@+id/btnVerifyKey"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:fontFamily="@font/extra_bold"
        android:focusable="true"
        android:elevation="@dimen/_4sdp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:minHeight="@dimen/button_height"
        android:paddingVertical="12dp"
        android:text="@string/forgot_pin_verify"
        android:textAllCaps="false"
        android:textColor="@color/text_on_accent"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
