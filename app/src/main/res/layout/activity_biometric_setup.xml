<?xml version="1.0" encoding="utf-8"?>
<!-- Biometric opt-in, styled like the passcode screens: splash background, ringed
     fingerprint mark, primary action pinned to the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sp_bg">

    <FrameLayout
        android:id="@+id/biometricMark"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:background="@drawable/bg_biometric_rings"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.23000002"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_biometric"
            android:src="@drawable/ic_fingerprint"
            app:tint="@color/primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.App.Bold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:text="@string/biometric_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/biometricMark" />

    <TextView
        android:id="@+id/subtitle"
        style="@style/TextAppearance.App.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_28sdp"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/biometric_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!-- Native Ad fills the gap between the copy and the action -->
    <FrameLayout
        android:id="@+id/flAdNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/_12sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:layout_constraintVertical_bias="1" />

    <!-- MaterialButton (not a TextView with a compound drawable): app:icon keeps the
         fingerprint glued to the label, while a drawableStart would sit at the far
         left edge of a full-width button. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/extra_bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.01"
        android:minHeight="@dimen/button_height"
        android:text="@string/biometric_enable"
        android:textAllCaps="false"
        android:textColor="@color/text_on_accent"
        android:textSize="16sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="@dimen/radius_m"
        app:icon="@drawable/ic_fingerprint"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/text_on_accent"
        app:layout_constraintBottom_toTopOf="@id/btnSkip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnSkip"
        style="@style/TextAppearance.App.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/_16sdp"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:text="@string/biometric_skip"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
